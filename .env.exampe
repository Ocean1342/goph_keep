GOOSE_DRIVER=postgres
GOOSE_DBSTRING="postgresql://ya:ya@localhost:5432/ya"
GOOSE_MIGRATION_DIR=./migrations
GOOSE_TABLE=ya.goose_migrations

RUN_ADDRESS=":8080"
DATABASE_URI="postgresql://ya:ya@localhost:5432/ya"
TOKEN_EXP_HOURS=1
SECRET_KEY="somesecretkey"
TOKEN_TTL=5
TLS_ENABLED=true
CERT_FILE="/some/path/tls.crt"
KEY_FILE="/some/path/tls.key"